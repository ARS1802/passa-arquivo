# Configuração do backend. Argumentos e ambiente externo têm prioridade.
PASSA_HOST=127.0.0.0
PASSA_PORT=8443
PASSA_TLS_MODE=self-signed

# Limites em bytes; ZIP_MAX_ENTRIES é uma quantidade de entradas.
PASSA_UPLOAD_MAX_BYTES=1073741824
PASSA_JSON_MAX_BYTES=16384
PASSA_ZIP_MAX_ENTRIES=10000
PASSA_ZIP_MAX_BYTES=10737418240
PASSA_SHUTDOWN_TIMEOUT_MS=10000

# Sem estas opções, a aplicação usa os caminhos automáticos já definidos:
# raiz no diretório do usuário, estado em model/peer e staging em tmp.
# Para substituir, informe caminhos absolutos; a raiz explícita precisa existir.
# PASSA_ROOT=/caminho/absoluto/para/pasta-compartilhada
# PASSA_STATE_DIR=/caminho/absoluto/do/projeto/model/peer
# PASSA_STAGING_DIR=/caminho/absoluto/do/projeto/tmp

# No modo provided, informe os dois arquivos da identidade existente em state-dir/tls.
# PASSA_TLS_CERT_FILE=/caminho/absoluto/do/projeto/model/peer/tls/server.crt
# PASSA_TLS_KEY_FILE=/caminho/absoluto/do/projeto/model/peer/tls/server.key
