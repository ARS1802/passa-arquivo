{
  "name": "passa-arquivo",
  "version": "0.1.0",
  "private": true,
  "description": "API HTTPS de arquivos para rede local, em desenvolvimento por etapas.",
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25",
    "npm": ">=11 <12"
  },
  "os": ["linux"],
  "packageManager": "npm@11.17.0",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/tests/*.test.js",
    "check": "npm run typecheck && npm run build && npm test",
    "check:config": "node dist/check-config.js"
  },
  "dependencies": {
    "express": "5.2.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "24.13.3",
    "typescript": "7.0.2"
  }
}
